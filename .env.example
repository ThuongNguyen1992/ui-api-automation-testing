# Copy to .env (never commit .env). Every variable is optional — the tests run without any of them.

# Report history (Google Sheets) — share the spreadsheet with the service account e-mail as Editor
GG_REPORT_SPREADSHEET_ID=
# service-account key: JSON content (CI secret) or a path to the key file (local)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_PATH=

# Google Chat run card — one webhook per environment, or a default one
GG_CHAT_WEBHOOK=
GG_CHAT_WEBHOOK_DEV=
GG_CHAT_WEBHOOK_STAG=
GG_CHAT_WEBHOOK_PROD=

# API / test logs: ERROR | WARN | INFO | DEBUG | VERBOSE
LOG_LEVEL=INFO
