{
  "name": "ui-api-automation-testing",
  "version": "1.0.0",
  "description": "UI + API test automation framework — Playwright + TypeScript, page objects, API service layer, multi-environment data, Allure reporting and CI on GitHub Actions",
  "author": "Thuong Nguyen",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "npm ci && npx playwright install chromium",
    "lint": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --project=\"UI - Auth\" --project=\"UI - Inventory\" --project=\"UI - Cart\" --project=\"UI - Checkout\"",
    "test:api": "playwright test --project=\"API - Auth\" --project=\"API - Products\" --project=\"API - Carts\"",
    "test:tag": "playwright test --grep",
    "test:smoke": "playwright test --grep @smoke",
    "test:smoke:ci": "playwright test --grep @smoke --workers=1 --retries=1",
    "test:smoke-ui": "playwright test --grep @smoke --grep-invert @api",
    "test:smoke-api": "playwright test --grep \"(?=.*@smoke)(?=.*@api)\"",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:e2e:ci": "playwright test --grep @e2e --workers=1 --retries=1",
    "test:auth": "playwright test --grep @auth",
    "test:inventory": "playwright test --grep @inventory",
    "test:cart": "playwright test --grep @cart",
    "test:checkout": "playwright test --grep @checkout",
    "test:headed": "playwright test --headed",
    "test:ui-mode": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "pw:codegen": "playwright codegen https://www.saucedemo.com",
    "pw:trace": "playwright show-trace",
    "env:dev": "node config/set-env-ci.js dev",
    "env:stag": "node config/set-env-ci.js stag",
    "env:prod": "node config/set-env-ci.js prod",
    "report:allure": "allure open reports/allure-report",
    "report:allure:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:html": "playwright show-report reports/html-report",
    "report:summary": "node src/core/reporting/github/job-summary.js",
    "report:screenshot": "node src/core/reporting/capture-report-screenshot.js",
    "report:gg-chat": "node src/core/reporting/google/google-chat-bot.js",
    "report:gg-history": "node src/core/reporting/google/report-history.js",
    "k6:smoke": "npm run k6:products -- -e PROFILE=smoke && npm run k6:auth -- -e PROFILE=smoke",
    "k6:load": "npm run k6:products -- -e PROFILE=load && npm run k6:auth -- -e PROFILE=load",
    "k6:products": "node -e \"require('fs').mkdirSync('reports/k6',{recursive:true})\" && k6 run k6/scenarios/products-api.js",
    "k6:auth": "node -e \"require('fs').mkdirSync('reports/k6',{recursive:true})\" && k6 run k6/scenarios/auth-flow.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "execa": "^9.5.1",
    "googleapis": "^144.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
